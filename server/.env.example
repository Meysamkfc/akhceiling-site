# Copy to .env (never commit/share .env). Every value is optional.
AKH_BASE_URL=https://akhceiling.com
AKH_HTTPS=1                 # 1 when the site is served over HTTPS (cookies become Secure, HSTS on)
AKH_TRUST_PROXY=0           # 1 only behind your own nginx/Apache proxy (real client IP from X-Forwarded-For)
# AKH_SECRET_KEY=           # auto-generated into instance/secret.key when empty

# Staff notifications (new lead / order / registration). Use the same Telegram bot as your CRM call-bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Daily digest of yesterday's new customer sign-ups, sent every morning to the sales team's group.
TELEGRAM_SALES_CHAT_ID=     # the sales team's Telegram GROUP chat id; falls back to TELEGRAM_CHAT_ID if empty
AKH_DAILY_DIGEST=1          # 0 to disable the daily digest entirely
AKH_DIGEST_HOUR=9           # local hour (0-23) to send it
# E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
# SMS via Kavenegar (comma separated mobile numbers)
KAVENEGAR_API_KEY=
NOTIFY_SMS_TO=
