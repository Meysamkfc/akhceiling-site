[Unit]
Description=AKH website + CRM (waitress)
After=network.target

[Service]
User=akh
Group=akh
WorkingDirectory=/srv/akh/server
EnvironmentFile=/srv/akh/server/.env
ExecStart=/srv/akh/server/.venv/bin/python -m waitress --listen=127.0.0.1:8790 --threads=8 app:app
Restart=always
RestartSec=3
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/akh/server/instance

[Install]
WantedBy=multi-user.target
